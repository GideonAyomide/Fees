# Database Configuration (PostgreSQL with pgvector)
# Note: In development and test, point to a local PostgreSQL instance.
# In production, this points to your Neon PostgreSQL connection string with pooling.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fees_dev?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Flutterwave Credentials (PRD Section 8.6 - unconfirmed in MVP build, loaded from environment only)
# FLW_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxx-X"
# FLW_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxx-X"
# FLW_SECRET_HASH="custom_webhook_secret_hash_value"
